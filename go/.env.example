# The base URL of the brainbase-mas service (used to resolve opaque preview
# ids to an upstream URL + auth token, provider-agnostically for Daytona and
# e2b)
MAS_BASE_URL=https://mas.brainbaselabs.com

# Shared secret sent as X-Internal-Secret when calling mas's
# POST /internal/preview/resolve endpoint
PREVIEW_RESOLVE_SECRET=

# The base domain previews are served under, e.g. requests to
# {previewId}.<this> are resolved and proxied
PREVIEW_BASE_DOMAIN=brainbaselabs.space

# (Optional) Where hosts that name a published Brainbase Interfaces dashboard
# are forwarded: a bare origin, no path. Dashboards live at hyphenated labels
# under PREVIEW_BASE_DOMAIN - `<slug>.<domain>` and its sibling frame host
# `app--<slug>.<domain>` - and the gateway resolves them itself, so nothing
# here needs to know which dashboards exist. Unset means this deployment
# serves no dashboards and refuses those hosts; set but unusable is fatal at
# boot rather than a silent outage.
INTERFACES_GATEWAY_URL=https://interfaces-gateway.internal

# (Optional) The port for the proxy server to listen on
PORT=3000
